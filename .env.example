# Supabase — Project Settings > API en https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role: bypasea RLS. Solo se usa en el servidor (booking publico, cron
# de recordatorios). NUNCA exponer con el prefijo NEXT_PUBLIC_ ni en el browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL publica de la app (usada para armar el link de reservas /b/[slug] y los
# redirectTo de los emails de auth). En local: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secreto compartido con Vercel Cron para autorizar /api/cron/reminders
# (ver vercel.json). Cualquier string largo y random sirve.
CRON_SECRET=

# Twilio WhatsApp Business API (WABA) — opcional. Sin esto, los envios de
# WhatsApp automaticos simplemente se saltan (console.log) y el negocio sigue
# operando con el flujo asistido (botones "wa.me" en el dashboard). Ver
# src/lib/whatsapp.ts.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Resend (email) — opcional. Actualmente src/lib/email.ts esta escrito pero no
# se llama desde ningun flujo (el booking publico no pide email del cliente).
RESEND_API_KEY=
